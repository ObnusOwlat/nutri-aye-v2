{
  "name": "meal-prep-planner-backend",
  "version": "1.0.0",
  "description": "Backend API for Meal Prep Planner - optional sync and backup service",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env\" server.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
