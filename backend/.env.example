# Copy to .env and adjust. Node loads it with --env-file-if-exists (npm start).

# Interface to listen on. 127.0.0.1 = only this computer.
# Use 0.0.0.0 to allow other computers on the network (only behind HTTPS, Fase 9).
HOST=127.0.0.1
PORT=3001

# SQLite database file (":memory:" for tests)
DB_PATH=./db/database.sqlite

# Sessions: hours without use before logging out, and maximum days
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# true only when served over HTTPS (Fase 9)
COOKIE_SECURE=false

# Automatic daily copy of the database: folder and how many days to keep
BACKUP_DIR=./db/respaldos
BACKUP_KEEP=30
